# The target build's own settings. Everything about the board - flash, PSRAM,
# cache, the console - arrives from kbsp's sdkconfig.board, which
# CMakeLists.txt fetches and reads first. Do not copy any of it here.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"

# The role every consumer of the SDK builds in.
CONFIG_KODEOS_BOOT_ROLE_APP=y

# J3's 3.3 V, the module's supply, is switched by a pin of the Dot's C5, and the owner asks for it
# with kode_sys_exp_power() when it starts (kode_sys.h, "J3's module supply"): the switch goes over
# the link to the C5, so the radio is on. WiFi and the stack above it are not: nothing here opens a
# socket, and a WiFi scan holds the link - the module's supply with it - for up to some 40 s. As
# kode-sdk's ir_remote example has it. BLE is left as kode-sdk
# sets it. The microSD needs the radio link too: the C5 switches the card's supply.
CONFIG_KODEOS_RADIO=y
CONFIG_KODEOS_WIFI=n
CONFIG_KODEOS_NET=n
CONFIG_KODEOS_CHANNEL=n

# The OV5640 and the default format the SDK's table needs: camera_drv_ov5640.c stops
# the build without the three it depends on.
CONFIG_CAMERA_OV5640=y
CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5640_DVP_RGB565_800X600_10FPS=y
CONFIG_CAMERA_OV5640_DVP_RGB565_BE_800X600_10FPS=y
CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_RGB565_BE_800X600_10FPS=y
