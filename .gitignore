# Design documents are written and kept outside the repository: they propose
# what will be, while the code, its header comments and the README say what is.
docs/specs/

# kode-sdk at the release tests/host_ao and tests/host_sys build against, cloned
# there by their CMakeLists.txt and never tracked.
tests/kode-sdk-*/
tests/host_ao/kode-sdk-*/

# The editor's index (clangd), wherever a build directory leads it.
.cache/

# The autofocus firmware is not ours to carry
# (components/camera_focus_firmware/NOTICE.md).
components/camera_focus_firmware/*.bin

# macOS
.DS_Store
