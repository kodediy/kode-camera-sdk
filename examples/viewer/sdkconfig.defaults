# The example's own settings. Everything about the board - flash, PSRAM,
# cache, the console, LVGL - arrives from kbsp's sdkconfig.board, which
# CMakeLists.txt fetches and reads first. Do not copy any of it here.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"

# An app, launched from kodeOS: any reset goes back home.
CONFIG_KODEOS_BOOT_ROLE_APP=y

# Kept: with the console up, `screenshot` shows what is on the glass.
CONFIG_KODEOS_CONSOLE=y

# J3's 3.3 V, the module's supply, is switched by a pin of the Dot's C5, and
# kodeOS starts every app with it off: camera_begin() switches it on with
# kode_sys_exp_power(), over the link to the C5 (kode_sys.h, "J3's module
# supply"). So the radio, but no WiFi or network: a
# WiFi scan holds the link - the module's supply with it - for up to some 40 s.
CONFIG_KODEOS_RADIO=y
CONFIG_KODEOS_WIFI=n
CONFIG_KODEOS_NET=n
CONFIG_KODEOS_CHANNEL=n
# BLE is left as kode-sdk sets it.

# The OV5640's format tables the SDK starts from: every app that uses this SDK
# carries these five lines (README.md, "Use it in your project").
CONFIG_CAMERA_OV5640=y
CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5640_DVP_RGB565_800X600_10FPS=y
CONFIG_CAMERA_OV5640_DVP_RGB565_BE_800X600_10FPS=y
CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_RGB565_BE_800X600_10FPS=y
